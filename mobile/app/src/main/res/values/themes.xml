<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème de fenêtre minimal ; les couleurs de l'interface vivent dans ui/theme (Compose). -->
    <style name="Theme.IdentiShield" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <!-- B-UI : dès la première image, barre d'état transparente à icônes sombres (plus de bande grise
             avant que l'écran de lancement ne se dessine ; constaté sur la tablette le 2026-10-17). -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <color name="background">#F4F7FB</color>
</resources>
