# LF partout : un script CRLF echoue dans un conteneur Linux (ISC-DEPLOY parite §6.2)
* text=auto eol=lf
*.sh text eol=lf
Makefile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.py text eol=lf
*.java text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.md text eol=lf
*.json text eol=lf
*.properties text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
# binaires
*.docx binary
*.png binary
*.jar binary
